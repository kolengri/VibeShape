{
  "name": "@vibeshape/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun run build.ts",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "typecheck": "bun run --bun tsc -p tsconfig.json && bun run --bun tsc -p tsconfig.test.json && bun run --bun tsc -p tsconfig.tools.json",
    "package": "bun run package.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vibeshape/automation-api": "workspace:*",
    "@vibeshape/mcp-server": "workspace:*",
    "@vibeshape/slicer-bridge": "workspace:*",
    "@vibeshape/slicer-handoff": "workspace:*",
    "semver": "7.8.5",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "26.1.2",
    "@types/semver": "7.8.0",
    "@vibeshape/typescript-config": "workspace:*",
    "electron": "44.9.0"
  }
}
