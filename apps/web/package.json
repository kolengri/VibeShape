{
  "name": "@vibeshape/web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "bun run ../../scripts/prepare-structural-runtime.ts && bun node_modules/vite/bin/vite.js",
    "dev:e2e": "bun run ../../scripts/prepare-structural-runtime.ts && bun node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4173",
    "build": "bun run ../../scripts/prepare-structural-runtime.ts && bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "typecheck": "bun run ../../scripts/check-types.ts tsconfig.json tsconfig.test.json tsconfig.vite.json"
  },
  "dependencies": {
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@tanstack/hotkeys": "catalog:",
    "@vibeshape/application": "workspace:*",
    "@vibeshape/automation-api": "workspace:*",
    "@vibeshape/automation-host": "workspace:*",
    "@vibeshape/document-worker": "workspace:*",
    "@vibeshape/domain": "workspace:*",
    "@vibeshape/formats": "workspace:*",
    "@vibeshape/geometry-worker": "workspace:*",
    "@vibeshape/i18n": "workspace:*",
    "@vibeshape/persistence": "workspace:*",
    "@vibeshape/print-analysis": "workspace:*",
    "@vibeshape/protocol": "workspace:*",
    "@vibeshape/slicer-handoff": "workspace:*",
    "@vibeshape/structural-optimization": "workspace:*",
    "@vibeshape/ui": "workspace:*",
    "@vibeshape/viewer": "workspace:*",
    "immer": "catalog:",
    "is-what": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-dropzone": "catalog:",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "26.1.2",
    "@vibeshape/mcp-server": "workspace:*",
    "rollup-plugin-license": "3.7.1",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vibeshape/extension-spike": "workspace:*",
    "@vibeshape/test-models": "workspace:*",
    "@vibeshape/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "catalog:",
    "fflate": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
