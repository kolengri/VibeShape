{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["bun"]
  },
  "include": [
    "tests/public/**/*.ts",
    "scripts/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/distribution/**/*.ts",
    "tests/desktop/**/*.ts",
    "tests/performance/**/*.ts",
    "tests/topology/**/*.ts",
    "playwright.config.ts",
    "playwright.distribution.config.ts",
    "playwright.desktop.config.ts",
    "playwright.public.config.ts",
    "playwright.performance.config.ts",
    "playwright.topology.config.ts",
    "packages/geometry-worker/src/vite-modules.d.ts"
  ],
  "exclude": ["tests/unit/support/dom.ts", "scripts/testing/bun-test-dom.test.ts"]
}
