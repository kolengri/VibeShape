    "./messages/en.json": "./src/messages/en.json",
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "typecheck": "bun run ../../scripts/check-types.ts tsconfig.json tsconfig.test.json"
  },
  "dependencies": {
    "@tanstack/react-form": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "is-what": "catalog:",
    "radix-ui": "catalog:",
    "react-resizable-panels": "catalog:",
    "tailwind-merge": "catalog:",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vibeshape/typescript-config": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
