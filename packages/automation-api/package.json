    "./draft-inspection": "./src/draft-inspection.ts",
    "./queries": "./src/queries.ts",
    "./local-tools": "./src/local-tools.ts",
    "./local-sketch-text-tools": "./src/local-sketch-text-tools.ts",
    "./local-session": "./src/local-session.ts",
    "./remote-session": "./src/remote-session.ts",
    "./tool-metadata": "./src/tool-metadata.ts",
    "./authored-metadata": "./src/authored-metadata.ts",
    "./agent-skills": "./src/agent-skills.ts",
    "./query-byte-budget": "./src/query-byte-budget.ts",
    "./binary-exports": "./src/binary-exports.ts",
    "./imports": "./src/imports.ts",
    "./planar-imports": "./src/planar-imports.ts",
    "./assembly-tools": "./src/assembly-tools.ts",
    "./library-tools": "./src/library-tools.ts",
    "./assembly-result-context": "./src/assembly-result-context.ts",
    "./history-tools": "./src/history-tools.ts",
    "./surface-texture-tools": "./src/surface-texture-tools.ts",
    "./surface-texture-result-context": "./src/surface-texture-result-context.ts",
    "./lightweighting-tools": "./src/lightweighting-tools.ts",
    "./quick-lightweighting-tools": "./src/quick-lightweighting-tools.ts"
