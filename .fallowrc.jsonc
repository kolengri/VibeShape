{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/v3.14.0/schema.json",
  // Vite and Playwright load these files through secondary CLI/HTML entry points.
  "entry": [
    // Bun scripts bundle/package the native main process; Playwright owns its native test config.
    "apps/desktop/build.ts",
    "apps/desktop/package.ts",
    "apps/desktop/src/main.ts",
    "apps/desktop/src/mcp.ts",
    "apps/desktop/src/preload.ts",
    "playwright.desktop.config.ts",
    "playwright.desktop-packaged.config.ts",
    // Electron integration tests spawn this harmless ACP protocol fixture by filename.
    "tests/desktop/fixtures/acp-agent.cjs",
    "apps/web/public/persistence-spike-sw.js",
    "apps/web/src/spikes/geometry-worker.ts",
    "apps/web/src/spikes/body-selection.tsx",
    "apps/web/src/spikes/extension-sandbox.ts",
    "apps/web/src/spikes/feature-rebuild.ts",
    "apps/web/src/spikes/persistence.ts",
    "apps/web/src/spikes/persisted-rebuild.ts",
    "apps/web/src/spikes/primitive-features.ts",
    "apps/web/src/spikes/sketch-worker.ts",
    "apps/web/src/spikes/three-mf.ts",
    "apps/web/src/spikes/topology.ts",
    // Vite emits this classic iframe renderer as an asset; it must never execute in the parent.
    "apps/web/src/features/extensions/ui-panel-runtime.js",
    "apps/slicer-bridge/src/index.ts",
    "apps/mcp-server/src/index.ts",
    "apps/remote-mcp/src/index.ts",
    "apps/remote-mcp/vitest.config.ts",
    // Bun preloads the Vite import adapter through a CLI runtime path.
    "tests/unit/support/vite-imports.ts",
    // Bun.build packages the relocatable launcher through a runtime entrypoint string.
    "scripts/local-distribution.ts",
    "playwright.formats.config.ts",
    "playwright.extension.config.ts",
    "playwright.persistence.config.ts",
    "playwright.performance.config.ts",
    "playwright.topology.config.ts",
    "playwright.public.config.ts"
  ],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },
  // Bun resolves these transitive security pins in bun.lock; Fallow currently checks pnpm lockfiles only.
  "ignoreDependencyOverrides": [
    { "package": "proxy-addr", "source": "package.json" },
    { "package": "fast-uri", "source": "package.json" },
    { "package": "qs", "source": "package.json" },
    { "package": "ip-address", "source": "package.json" },
    { "package": "sharp", "source": "package.json" }
  ],
  "ignorePatterns": [
    "**/__generated__/**",
    "**/generated/**",
    // Exact source-built SolveSpace outputs are verified by SHA-256 before analysis and bundling.
    "packages/sketch-solver/runtime/**",
    // Vite resolves secondary HTML entry scripts; their TypeScript files are explicit entries above.
    "apps/web/spikes/*.html"
  ],
  "duplicates": {
    // Pair-only similarity is often incidental. Gate widespread copy-paste.
    "minOccurrences": 3,
    "ignore": ["packages/test-models/**"]
  },
  "boundaries": {
    "zones": [
      { "name": "web", "patterns": ["apps/web/**"] },
      { "name": "mcp-server", "patterns": ["apps/mcp-server/**"] },
      { "name": "remote-mcp", "patterns": ["apps/remote-mcp/**"] },
      { "name": "slicer-bridge", "patterns": ["apps/slicer-bridge/**"] },
      { "name": "i18n", "patterns": ["packages/i18n/**"] },
      { "name": "domain", "patterns": ["packages/domain/**"] },
      { "name": "application", "patterns": ["packages/application/**"] },
      { "name": "document-worker", "patterns": ["packages/document-worker/**"] },
      { "name": "extension-spike", "patterns": ["packages/extension-spike/**"] },
      {
        "name": "automation-api",
        "patterns": ["packages/automation-api/**"]
      },
      {
        "name": "automation-host",
        "patterns": ["packages/automation-host/**"]
      },
      { "name": "protocol", "patterns": ["packages/protocol/**"] },
      {
        "name": "geometry-worker",
        "patterns": ["packages/geometry-worker/**"]
      },
      { "name": "sketch-solver", "patterns": ["packages/sketch-solver/**"] },
      { "name": "viewer", "patterns": ["packages/viewer/**"] },
      { "name": "persistence", "patterns": ["packages/persistence/**"] },
      { "name": "formats", "patterns": ["packages/formats/**"] },
      {
        "name": "print-analysis",
        "patterns": ["packages/print-analysis/**"]
      },
      { "name": "ui", "patterns": ["packages/ui/**"] },
      { "name": "test-models", "patterns": ["packages/test-models/**"] },
      { "name": "slicer-handoff", "patterns": ["packages/slicer-handoff/**"] },
      { "name": "structural-optimization", "patterns": ["packages/structural-optimization/**"] }
    ],
    "rules": [
      // Stable core rule: the domain has no internal package dependencies.
      { "from": "domain", "allow": [] },
      // Serializable slicer handoff contracts have no application or native authority.
      { "from": "slicer-handoff", "allow": [] },
      // The loopback adapter depends only on its strict shared contract.
      { "from": "slicer-bridge", "allow": ["slicer-handoff"] },
      { "from": "mcp-server", "allow": ["automation-api"] },
      { "from": "remote-mcp", "allow": ["automation-api"] },
      // Use-case coordination depends on pure domain policy and serializable runtime contracts.
      { "from": "application", "allow": ["domain", "protocol"] },
      // The document worker composes application policy, native geometry, and approved file formats.
      {
        "from": "document-worker",
        "allow": [
          "application",
          "domain",
          "formats",
          "geometry-worker",
          "print-analysis",
          "protocol",
          "sketch-solver"
        ]
      },
      // Serializable automation contracts may depend only on the pure domain model.
      { "from": "automation-api", "allow": ["domain"] },
      // Host policy coordinates public automation contracts and pure domain operations.
      {
        "from": "automation-host",
        "allow": ["automation-api", "domain"]
      },
      // Shared visual primitives cannot depend on CAD or application packages.
      { "from": "ui", "allow": [] },
      // Localization infrastructure remains independent of application and CAD packages.
      { "from": "i18n", "allow": [] },
      // Protocol schemas are the dependency-free structured-clone boundary.
      { "from": "protocol", "allow": [] },
      // Bounded print-copy generation consumes serializable contracts, never UI or persistence.
      { "from": "print-analysis", "allow": ["protocol"] },
      // Numerical workers can validate manufacturing meshes without UI or document authority.
      { "from": "structural-optimization", "allow": ["domain", "formats"] },
      // The geometry worker depends on contracts, never on UI or persistence.
      { "from": "geometry-worker", "allow": ["protocol", "test-models"] },
      // The sketch solver compiles pure domain records into the private native ABI.
      { "from": "sketch-solver", "allow": ["domain"] },
      // Fixture packages contain data and invariants, not runtime adapters.
      { "from": "test-models", "allow": [] }
    ]
  },
  "rules": {
    "stale-suppressions": "error",
    "require-suppression-reason": "error"
  }
}
